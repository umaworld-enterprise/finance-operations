# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Advance Deposit Tracker"
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# ── Google OAuth (sign-in) ───────────────────────────────────────────────────
# Optional in development (dev mode bypasses auth), required elsewhere.
# Client ID is public (shared with the frontend); the secret never leaves here.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# App-issued JWT session lifetime in minutes (default 720 = 12h)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: docker compose up spins up postgres at localhost:5432/adt
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adt

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# ── Google Drive (TT copy uploads) ───────────────────────────────────────────
# Folder MUST be on a Shared Drive (service accounts have zero My Drive storage
# quota) and shared with the service account email as Content Manager.
# Empty GOOGLE_DRIVE_FOLDER_ID → TT copy upload returns 502.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys --json
# Public key must ALSO be set as NEXT_PUBLIC_VAPID_PUBLIC_KEY on the frontend
# BEFORE its build. Empty → push skipped, in-app bell still works.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@yourcompany.com

# ── SMTP (HoM / super-admin payment emails) ──────────────────────────────────
# Empty SMTP_HOST → email sending silently disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Analytics ────────────────────────────────────────────────────────────────
# Override defaults — these are also stored in system_config table
DEFAULT_ETD_GRACE_DAYS=10
DEFAULT_COST_OF_FUND_RATE=0.12
DEFAULT_COST_OF_FUND_GRACE_DAYS=30
