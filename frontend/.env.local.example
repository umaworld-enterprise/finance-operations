# Supabase (public keys — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Administrator contact email — shown on the "Access Not Granted" screen
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourcompany.com

# Web Push VAPID public key (pair generated with: npx web-push generate-vapid-keys)
# Must match the backend's VAPID_PUBLIC_KEY. Inlined at BUILD time — set it
# before `npm run build` / the Railway build, not after. Empty → push UI hidden.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
